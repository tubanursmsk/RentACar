@model RentACar.AdminPanel.Models.CreateViewModel
@using RentACar.Application.DTOs.Brand
@using RentACar.Application.DTOs.Location
@using RentACar.Domain.Entities

@{
    ViewData["Title"] = "Yeni Araç Ekle";
    var brands = ViewBag.AllBrands as List<BrandDto> ?? new List<BrandDto>();
    var locations = ViewBag.AllLocations as List<LocationDto> ?? new List<LocationDto>();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🚗 @ViewData["Title"]</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Listeye Dön
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- ═══ TEMEL BİLGİLER ═══ -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">📝 Temel Bilgiler</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BrandId" class="form-label"></label>
                        <select asp-for="BrandId" class="form-select">
                            <option value="">Marka seçin...</option>
                            @foreach (var b in brands)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CurrentLocationId" class="form-label"></label>
                        <select asp-for="CurrentLocationId" class="form-select">
                            <option value="">Şube seçin...</option>
                            @foreach (var l in locations)
                            {
                                <option value="@l.Id">@l.Name — @l.City</option>
                            }
                        </select>
                        <span asp-validation-for="CurrentLocationId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" placeholder="Örn: Corolla" />
                        <span asp-validation-for="Model" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Year" class="form-label"></label>
                        <input asp-for="Year" type="number" class="form-control" />
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Plate" class="form-label"></label>
                        <input asp-for="Plate" class="form-control" placeholder="34 ABC 123" />
                        <span asp-validation-for="Plate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="DailyPrice" class="form-label"></label>
                        <input asp-for="DailyPrice" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="DailyPrice" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Color" class="form-label"></label>
                        <input asp-for="Color" class="form-control" placeholder="Örn: Beyaz" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CarStatus>()"></select>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ ARAÇ ÖZELLİKLERİ ═══ -->
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">⚙️ Araç Özellikleri</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="FuelType" class="form-label"></label>
                        <select asp-for="FuelType" class="form-select">
                            <option value="1">Benzin</option>
                            <option value="2">Dizel</option>
                            <option value="3">Elektrik</option>
                            <option value="4">Hibrit</option>
                            <option value="5">LPG</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="TransmissionType" class="form-label"></label>
                        <select asp-for="TransmissionType" class="form-select">
                            <option value="1">Manuel</option>
                            <option value="2">Otomatik</option>
                            <option value="3">Yarı Otomatik</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Mileage" class="form-label"></label>
                        <input asp-for="Mileage" type="number" class="form-control" placeholder="Örn: 15000" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="SeatCount" class="form-label"></label>
                        <input asp-for="SeatCount" type="number" min="2" max="9" class="form-control" />
                        <span asp-validation-for="SeatCount" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="DoorCount" class="form-label"></label>
                        <input asp-for="DoorCount" type="number" min="2" max="5" class="form-control" />
                        <span asp-validation-for="DoorCount" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LuggageCount" class="form-label"></label>
                        <input asp-for="LuggageCount" type="number" min="0" max="10" class="form-control" />
                        <span asp-validation-for="LuggageCount" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Aracın kısa açıklaması..."></textarea>
                </div>
            </div>
        </div>

        <!-- ═══ EK ÖZELLİKLER ═══ -->
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">✨ Ek Özellikler</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <div class="form-check form-switch">
                            <input asp-for="HasAirbag" class="form-check-input" />
                            <label asp-for="HasAirbag" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="form-check form-switch">
                            <input asp-for="HasAbs" class="form-check-input" />
                            <label asp-for="HasAbs" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="form-check form-switch">
                            <input asp-for="HasAirConditioning" class="form-check-input" />
                            <label asp-for="HasAirConditioning" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="form-check form-switch">
                            <input asp-for="HasBluetooth" class="form-check-input" />
                            <label asp-for="HasBluetooth" class="form-check-label"></label>
                        </div>
                    </div>
                    <div class="col-md-4 mb-2">
                        <div class="form-check form-switch">
                            <input asp-for="HasNavigation" class="form-check-input" />
                            <label asp-for="HasNavigation" class="form-check-label"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ KİRALAMA KOŞULLARI ═══ -->
        <div class="card mb-3">
            <div class="card-header bg-warning">
                <h5 class="mb-0">📋 Kiralama Koşulları</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="MinDriverAge" class="form-label"></label>
                        <input asp-for="MinDriverAge" type="number" min="18" max="75" class="form-control" />
                        <small class="text-muted">Örn: 21 → "21 Yaş Ve Üstü"</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="MinLicenseYears" class="form-label"></label>
                        <input asp-for="MinLicenseYears" type="number" min="0" max="20" class="form-control" />
                        <small class="text-muted">Örn: 1 → "Ehliyet Yaşı 1 Ve Üzeri"</small>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="MinFindeksScore" class="form-label"></label>
                        <input asp-for="MinFindeksScore" type="number" min="0" max="2000" class="form-control" />
                        <small class="text-muted">0 = Findeks skoru zorunlu değil</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ FOTOĞRAF ═══ -->
        <div class="card mb-3">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">📷 Araç Fotoğrafı</h5>
            </div>
            <div class="card-body">
                <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                <small class="text-muted">Desteklenen formatlar: JPG, PNG, WebP • Maks. 5MB</small>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            <button type="submit" class="btn btn-primary btn-lg px-5">
                ✓ Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
