@using RentACar.Application.DTOs.Brand
@using RentACar.Application.DTOs.Location
@using RentACar.Domain.Entities
@model CarEditViewModel
@{
    ViewData["Title"] = "Araç Düzenle";
    ViewData["Breadcrumb"] = "Araç Düzenle";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Araçı Düzenle</h1>
        <p>Araç bilgilerini güncelleyin.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 350px; gap: 20px; max-width: 1000px;">

    @* ── Form ── *@
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card-header">
            <span class="card-title">Araç Bilgileri</span>
        </div>

        <div class="card-body">

            @* ── Marka & Şube (2 kolon) ── *@
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="BrandId" class="form-label">Marka <span style="color: var(--danger);">*</span></label>
                    <select asp-for="BrandId" class="form-control" asp-items="@(new SelectList((IEnumerable<BrandDto>)ViewBag.Brands, "Id", "Name"))">
                        <option value="">-- Marka Seçin --</option>
                    </select>
                    <span asp-validation-for="BrandId" class="invalid-feedback"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CurrentLocationId" class="form-label">Şube <span style="color: var(--danger);">*</span></label>
                    <select asp-for="CurrentLocationId" class="form-control" asp-items="@(new SelectList((IEnumerable<LocationDto>)ViewBag.Locations, "Id", "Name"))">
                        <option value="">-- Şube Seçin --</option>
                    </select>
                    <span asp-validation-for="CurrentLocationId" class="invalid-feedback"></span>
                </div>
            </div>

            @* ── Model & Yıl (2 kolon) ── *@
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="Model" class="form-label">Model <span style="color: var(--danger);">*</span></label>
                    <input asp-for="Model" type="text" class="form-control" placeholder="Örn: A3, 5 Serisi" />
                    <span asp-validation-for="Model" class="invalid-feedback"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Year" class="form-label">Yıl <span style="color: var(--danger);">*</span></label>
                    <input asp-for="Year" type="number" class="form-control" placeholder="2023" />
                    <span asp-validation-for="Year" class="invalid-feedback"></span>
                </div>
            </div>

            @* ── Plaka ── *@
            <div class="form-group">
                <label asp-for="Plate" class="form-label">Plaka <span style="color: var(--danger);">*</span></label>
                <input asp-for="Plate" type="text" class="form-control" placeholder="34 ABC 123" />
                <small style="color: var(--text-muted);">Türkiye plakası formatında giriniz (Örn: 34 ABC 123)</small>
                <span asp-validation-for="Plate" class="invalid-feedback"></span>
            </div>

            @* ── Fiyat & Findeks (2 kolon) ── *@
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="DailyPrice" class="form-label">Günlük Fiyat (₺) <span style="color: var(--danger);">*</span></label>
                    <input asp-for="DailyPrice" type="number" step="0.01" class="form-control" placeholder="500.00" />
                    <span asp-validation-for="DailyPrice" class="invalid-feedback"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MinFindeksScore" class="form-label">Min. Findeks Puanı</label>
                    <input asp-for="MinFindeksScore" type="number" class="form-control" placeholder="0" />
                    <span asp-validation-for="MinFindeksScore" class="invalid-feedback"></span>
                </div>
            </div>

            @* ── Durum ── *@
            <div class="form-group">
                <label asp-for="Status" class="form-label">Durum</label>
                <select asp-for="Status" class="form-control">
                    <option value="@CarStatus.Available">Müsait</option>
                    <option value="@CarStatus.Rented">Kirada</option>
                    <option value="@CarStatus.InMaintenance">Bakımda</option>
                    <option value="@CarStatus.Passive">Pasif</option>
                </select>
            </div>

        </div>

        <div style="padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; gap: 8px; justify-content: flex-end;">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-save"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>

    @* ── Sidebar: Bilgiler + Resim ── *@
    <div class="card">
        <div class="card-header">
            <span class="card-title">Araç Resmi</span>
        </div>
        <div class="card-body" style="display: flex; flex-direction: column; gap: 12px;">

            @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
            {
                <img src="@Model.CurrentImageUrl" alt="@Model.Model" 
                     style="width: 100%; border-radius: var(--radius-md); border: 1px solid var(--border-color); object-fit: cover; aspect-ratio: 1;" />
            }
            else
            {
                <div style="width: 100%; aspect-ratio: 1; background: var(--bg-elevated); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; border: 1px dashed var(--border-color);">
                    <div style="text-align: center; color: var(--text-muted);">
                        <i class="fa-solid fa-image" style="font-size: 32px; opacity: 0.5;"></i>
                        <p style="margin-top: 8px; font-size: 0.85rem;">Resim yüklenmedi</p>
                    </div>
                </div>
            }

            <button type="button" class="btn btn-primary btn-sm" onclick="document.getElementById('imageUploadModal').classList.add('show');">
                <i class="fa-solid fa-cloud-arrow-up"></i> Resim Yükle
            </button>

            <hr style="margin: 8px 0; border: none; border-top: 1px solid var(--border-color);" />

            <p style="font-size: 0.8rem; color: var(--text-muted);">
                <strong>Desteklenen formatlar:</strong><br />
                JPG, PNG, GIF<br />
                <strong>Max boyut:</strong> 5MB
            </p>
        </div>
    </div>

</div>

@* ── IMAGE UPLOAD MODAL ── *@
<div class="modal-backdrop" id="imageUploadModal">
    <div class="modal" style="max-width: 420px;">
        <div class="modal-header">
            <span class="modal-title">Araç Resmi Yükle</span>
            <button type="button" class="modal-close" onclick="document.getElementById('imageUploadModal').classList.remove('show');">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>

        <div class="modal-body">
            <form id="imageUploadForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                @* Drag & Drop Zone *@
                <div style="position: relative; border: 2px dashed var(--border-color); border-radius: var(--radius-md); padding: 32px 20px; text-align: center; cursor: pointer; transition: all 0.15s; background: var(--bg-elevated);" id="dropZone">
                    <i class="fa-solid fa-cloud-arrow-up" style="font-size: 32px; color: var(--accent); margin-bottom: 10px;"></i>
                    <p style="color: var(--text-muted); margin: 8px 0; font-size: 0.9rem;">
                        Resmi buraya sürükleyin veya <strong>tıklayın</strong>
                    </p>
                    <small style="color: var(--text-muted);">JPG, PNG, GIF — Max 5MB</small>
                    <input type="file" id="fileInput" accept="image/*" style="display: none;" />
                </div>

                @* Progress ── *@
                <div id="uploadProgress" style="display: none; margin-top: 16px;">
                    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                        <div style="flex: 1;">
                            <div style="background: var(--bg-elevated); height: 6px; border-radius: 3px; overflow: hidden;">
                                <div id="progressBar" style="height: 100%; background: var(--accent); width: 0%; transition: width 0.3s;"></div>
                            </div>
                        </div>
                        <span id="progressText" style="font-size: 0.8rem; color: var(--text-muted);">0%</span>
                    </div>
                    <p id="uploadingText" style="font-size: 0.85rem; color: var(--text-muted); text-align: center;">Yükleniyor...</p>
                </div>

                @* Hata Mesajı ── *@
                <div id="errorMessage" style="display: none; margin-top: 12px; padding: 10px 12px; background: var(--danger-muted); color: var(--danger); border-radius: var(--radius-sm); font-size: 0.85rem;"></div>

                @* Başarı Mesajı ── *@
                <div id="successMessage" style="display: none; margin-top: 12px; padding: 10px 12px; background: var(--success-muted); color: var(--success); border-radius: var(--radius-sm); font-size: 0.85rem;"></div>
            </form>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('imageUploadModal').classList.remove('show');">
                İptal
            </button>
            <button type="button" class="btn btn-primary" id="uploadBtn" onclick="uploadImage();">
                <i class="fa-solid fa-cloud-arrow-up"></i> Yükle
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const modal = document.getElementById('imageUploadModal');
    const carId = @Model.Id;

    // Drag & Drop
    if (dropZone && fileInput) {
        dropZone.addEventListener('click', () => fileInput.click());

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.style.borderColor = 'var(--accent)';
                dropZone.style.backgroundColor = 'var(--accent-muted)';
            });
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.style.borderColor = 'var(--border-color)';
                dropZone.style.backgroundColor = 'var(--bg-elevated)';
            });
        });

        dropZone.addEventListener('drop', (e) => {
            const files = e.dataTransfer.files;
            if (files.length > 0) {
                fileInput.files = files;
                showSelectedFile();
            }
        });

        fileInput.addEventListener('change', showSelectedFile);
    }

    function showSelectedFile() {
        if (fileInput.files.length > 0) {
            const file = fileInput.files[0];
            const sizeMB = (file.size / 1024 / 1024).toFixed(2);
            dropZone.innerHTML = `
                <i class="fa-solid fa-check-circle" style="font-size: 32px; color: var(--success); margin-bottom: 10px;"></i>
                <p style="color: var(--text-primary); margin: 8px 0; font-weight: 500; font-size: 0.9rem;">
                    ${file.name}
                </p>
                <small style="color: var(--text-muted);">${sizeMB} MB</small>
            `;
        }
    }

    async function uploadImage() {
        if (!fileInput.files || fileInput.files.length === 0) {
            showError('Lütfen bir resim seçiniz.');
            return;
        }

        const file = fileInput.files[0];

        // Validasyon
        const allowedExtensions = ['jpg', 'jpeg', 'png', 'gif'];
        const extension = file.name.split('.').pop().toLowerCase();
        
        if (!allowedExtensions.includes(extension)) {
            showError('Sadece JPG, PNG, GIF dosyaları kabul edilir.');
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            showError('Dosya boyutu 5MB\'ı geçemez.');
            return;
        }

        // Upload başlat
        showProgress();

        const formData = new FormData();
        formData.append('file', file);

        try {
            const response = await fetch(`/Car/UploadImage/${carId}`, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-CSRF-TOKEN': document.querySelector('input[name="__RequestVerificationToken"]').value
                }
            });

            const result = await response.json();

            if (result.success) {
                showSuccess('Resim başarıyla yüklendi! Sayfayı yenileyerek değişiklikleri görebilirsiniz.');
                setTimeout(() => {
                    location.reload();
                }, 2000);
            } else {
                showError(result.message || 'Resim yüklenirken hata oluştu.');
            }
        } catch (error) {
            console.error('Upload error:', error);
            showError('Resim yüklenirken hata oluştu: ' + error.message);
        }
    }

    function showProgress() {
        document.getElementById('uploadProgress').style.display = 'block';
        document.getElementById('errorMessage').style.display = 'none';
        document.getElementById('successMessage').style.display = 'none';
        document.getElementById('uploadBtn').disabled = true;
    }

    function showError(message) {
        document.getElementById('uploadProgress').style.display = 'none';
        document.getElementById('errorMessage').textContent = message;
        document.getElementById('errorMessage').style.display = 'block';
        document.getElementById('uploadBtn').disabled = false;
    }

    function showSuccess(message) {
        document.getElementById('uploadProgress').style.display = 'none';
        document.getElementById('successMessage').textContent = message;
        document.getElementById('successMessage').style.display = 'block';
        document.getElementById('uploadBtn').disabled = true;
    }

    // Modal kapanırken temizle
    document.addEventListener('click', (e) => {
        if (e.target === modal) {
            modal.classList.remove('show');
            fileInput.value = '';
            document.getElementById('uploadProgress').style.display = 'none';
            document.getElementById('errorMessage').style.display = 'none';
            document.getElementById('successMessage').style.display = 'none';
            document.getElementById('uploadBtn').disabled = false;
        }
    });
</script>
}
