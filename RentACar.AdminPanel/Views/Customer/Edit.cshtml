@model RentACar.AdminPanel.Models.CustomerUpdateViewModel
@{
    ViewData["Title"] = "Müşteri Düzenle";
    ViewData["Breadcrumb"] = "Müşteri Düzenle";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Müşteriyi Düzenle</h1>
        <p>Müşterinin Findeks puanı ve iletişim bilgilerini güncelleyin.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr; max-width: 800px;">
    <form asp-action="Edit" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="UserId" />

        <div class="card-header">
            <span class="card-title">@Model.FullName - Bilgileri</span>
        </div>

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label class="form-label">Ad Soyad (Sistemden Çekildi)</label>
                <input asp-for="FullName" class="form-control" disabled style="background-color: var(--bg-body);" />
                <input type="hidden" asp-for="FullName" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="IdentityNumber" class="form-label">TC Kimlik No <span style="color: var(--danger);">*</span></label>
                    <input asp-for="IdentityNumber" class="form-control" maxlength="11" />
                    <span asp-validation-for="IdentityNumber" class="invalid-feedback"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Phone" class="form-label">Telefon <span style="color: var(--danger);">*</span></label>
                    <input asp-for="Phone" class="form-control" placeholder="05XX XXX XX XX" />
                    <span asp-validation-for="Phone" class="invalid-feedback"></span>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="DateOfBirth" class="form-label">Doğum Tarihi <span style="color: var(--danger);">*</span></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="invalid-feedback"></span>
                </div>
                <div class="form-group">
                    <label asp-for="FindeksScore" class="form-label">Findeks Puanı <span style="color: var(--danger);">*</span></label>
                    <input asp-for="FindeksScore" type="number" min="0" max="1900" class="form-control" style="font-weight: bold; color: var(--primary);" />
                    <span asp-validation-for="FindeksScore" class="invalid-feedback"></span>
                </div>
            </div>

            <div class="alert alert-info mt-16" style="margin-top: 16px;">
                <i class="fa-solid fa-circle-info"></i> Müşterinin adını, soyadını veya şifresini sadece Sistem Yöneticisi "Kullanıcılar" menüsünden değiştirebilir.
            </div>
        </div>

        <div style="padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; gap: 8px; justify-content: flex-end;">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save"></i> Değişiklikleri Kaydet</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }