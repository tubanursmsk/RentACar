@model RentACar.AdminPanel.Models.LocationUpdateViewModel
@{
    ViewData["Title"] = "Şube Düzenle";
    ViewData["Breadcrumb"] = "Şube Düzenle";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Şubeyi Düzenle</h1>
        <p>Mevcut şube bilgilerini ve adresini güncelleyin.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr; max-width: 800px;">
    <form asp-action="Edit" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card-header">
            <span class="card-title">Şube Bilgileri</span>
        </div>

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="Name" class="form-label">Şube Adı <span style="color: var(--danger);">*</span></label>
                    <input asp-for="Name" type="text" class="form-control" />
                    <span asp-validation-for="Name" class="invalid-feedback"></span>
                </div>

                <div class="form-group">
                    <label asp-for="City" class="form-label">Şehir <span style="color: var(--danger);">*</span></label>
                    <input asp-for="City" type="text" class="form-control" />
                    <span asp-validation-for="City" class="invalid-feedback"></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label asp-for="Address" class="form-label">Açık Adres <span style="color: var(--danger);">*</span></label>
                <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Address" class="invalid-feedback"></span>
            </div>
        </div>

        <div style="padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; gap: 8px; justify-content: flex-end;">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-save"></i> Değişiklikleri Kaydet
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}