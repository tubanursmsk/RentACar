@model RentACar.AdminPanel.Models.LocationListViewModel
@{
    ViewData["Title"] = "Şube Yönetimi";
    ViewData["Breadcrumb"] = "Şubeler";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Şube Yönetimi</h1>
        <p>Sistemdeki kiralama ofislerini (şubeleri) yönetin.</p>
    </div>
    <div style="display:flex; gap:10px;">
        <a asp-action="ExportExcel" class="btn btn-secondary">
            <i class="fa-solid fa-file-excel"></i> Excel İndir
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Yeni Şube Ekle
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <span class="card-title">Şubeler (@Model.Locations.TotalCount)</span>
    </div>
    <div class="table-wrapper">
        @if (Model.Locations.Items.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Şube Adı</th>
                        <th>Şehir</th>
                        <th>Adres</th>
                        <th style="width: 100px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var location in Model.Locations.Items)
                    {
                        <tr>
                            <td class="fw-600">@location.Name</td>
                            <td><span class="badge badge-info">@location.City</span></td>
                            <td style="max-width: 300px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@location.Address">
                                @location.Address
                            </td>
                            <td>
                                <div style="display: flex; gap: 4px;">
                                    <a asp-action="Edit" asp-route-id="@location.Id" 
                                       class="btn btn-icon btn-secondary" title="Düzenle">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@location.Id" method="post" style="display: inline;">
                                        <button type="submit" class="btn btn-icon btn-danger" 
                                                title="Sil" 
                                                onclick="return confirm('Bu şubeyi silmek istediğinizden emin misiniz?');">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="padding: 40px; text-align: center;">
                <i class="fa-solid fa-map-location-dot" style="font-size: 32px; color: var(--text-muted); opacity: 0.5;"></i>
                <p style="margin-top: 12px; color: var(--text-muted);">Henüz şube kaydı bulunamadı.</p>
                <a asp-action="Create" class="btn btn-primary mt-16">
                    <i class="fa-solid fa-plus"></i> İlk Şubeyi Ekle
                </a>
            </div>
        }
    </div>

    @* ── Pagination ── *@
    @if (Model.Locations.TotalPages > 1)
    {
        <div style="padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
            <span style="font-size: 0.85rem; color: var(--text-muted);">
                Sayfa @Model.Locations.PageNumber / @Model.Locations.TotalPages
            </span>
            <nav aria-label="Pagination" class="pagination">
                @if (Model.Locations.HasPreviousPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-page="1"><i class="fa-solid fa-angles-left"></i></a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" asp-route-page="@(Model.Locations.PageNumber - 1)"><i class="fa-solid fa-angle-left"></i></a>
                    </li>
                }

                @for (int i = 1; i <= Model.Locations.TotalPages; i++)
                {
                    if (i == Model.Locations.PageNumber)
                    {
                        <li class="page-item active"><span class="page-link">@i</span></li>
                    }
                    else if ((i >= Model.Locations.PageNumber - 2 && i <= Model.Locations.PageNumber + 2) || i == 1 || i == Model.Locations.TotalPages)
                    {
                        <li class="page-item"><a class="page-link" asp-route-page="@i">@i</a></li>
                    }
                    else if (i == Model.Locations.PageNumber - 3 || i == Model.Locations.PageNumber + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }

                @if (Model.Locations.HasNextPage)
                {
                    <li class="page-item">
                        <a class="page-link" asp-route-page="@(Model.Locations.PageNumber + 1)"><i class="fa-solid fa-angle-right"></i></a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" asp-route-page="@Model.Locations.TotalPages"><i class="fa-solid fa-angles-right"></i></a>
                    </li>
                }
            </nav>
        </div>
    }
</div>