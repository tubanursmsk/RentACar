@model RentACar.AdminPanel.Models.UserUpdateViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
    ViewData["Breadcrumb"] = "Kullanıcı Düzenle";
}

<div class="page-header">
    <div class="page-header-title">
        <h1>Kullanıcıyı Düzenle</h1>
        <p>Kullanıcının profil bilgilerini ve sistem yetkilerini değiştirin.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr; max-width: 800px;">
    <form asp-action="Edit" method="post" class="card">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card-header">
            <span class="card-title">Profil ve Yetki Güncelleme</span>
        </div>

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 18px;">
                <div class="form-group">
                    <label asp-for="FirstName" class="form-label">Ad <span style="color: var(--danger);">*</span></label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="invalid-feedback"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LastName" class="form-label">Soyad <span style="color: var(--danger);">*</span></label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="invalid-feedback"></span>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 18px;">
                <label asp-for="Email" class="form-label">E-Posta <span style="color: var(--danger);">*</span></label>
                <input asp-for="Email" type="email" class="form-control" />
                <span asp-validation-for="Email" class="invalid-feedback"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role" class="form-label">Yetki (Rol) <span style="color: var(--danger);">*</span></label>
                <select asp-for="Role" class="form-control">
                    <option value="Customer">Müşteri (Customer)</option>
                    <option value="Staff">Personel (Staff)</option>
                    <option value="CompanyManager">Şube Yöneticisi (CompanyManager)</option>
                    <option value="Admin">Sistem Yöneticisi (Admin)</option>
                </select>
                <span asp-validation-for="Role" class="invalid-feedback"></span>
            </div>
            
            <div class="alert alert-warning mt-16" style="margin-top: 16px;">
                <i class="fa-solid fa-circle-info"></i> Şifre güncelleme işlemleri güvenlik nedeniyle kullanıcının kendi paneli üzerinden yapılmalıdır.
            </div>
        </div>

        <div style="padding: 16px 20px; border-top: 1px solid var(--border-color); display: flex; gap: 8px; justify-content: flex-end;">
            <a asp-action="Index" class="btn btn-secondary">İptal</a>
            <button type="submit" class="btn btn-primary"><i class="fa-solid fa-save"></i> Değişiklikleri Kaydet</button>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
```</IActionResult>